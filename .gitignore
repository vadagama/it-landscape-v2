# Канвас: рабочая доска, съёмка, служебные данные — не история проекта
.canvas/

# Локальные настройки агентов
.claude/

# BMad: фреймворк ставится и обновляется установщиком, в git не нужен.
# Результаты работы (_bmad-output/) остаются под контролем версий.
_bmad/

# Секреты и окружение
.env
.env.*
!.env.example

# Зависимости и сборки — на случай появления кода в проекте
node_modules/
dist/
build/
out/

# Логи
*.log
npm-debug.log*
yarn-error.log*

# ОС и редакторы
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
